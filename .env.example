# Copy to .env and fill values. Never commit .env.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Telegram (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Earnings target (USD)
MONTHLY_GOAL_USD=100

# Safety must stay true
SAFETY_SYSTEM_ENABLED=true
MAX_AGENTS=6
MAX_RETRY_ATTEMPTS=3

# Optional dashboard gate (leave empty for local-only, no password)
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8501

LOG_LEVEL=INFO
